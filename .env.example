# Use ghcr.io/42ae/moodle or aesr/moodle.
MOODLE_IMAGE=ghcr.io/42ae/moodle

# Recommended values: 5.2, 4.5, or legacy upgrade bridges 4.1 and 3.11.
MOODLE_VERSION=5.2
MOODLE_PORT=8080
MOODLE_WWW_ROOT=http://localhost:8080
MOODLE_CRON_INTERVAL=60
MOODLE_REVERSE_PROXY=false
MOODLE_SSL_PROXY=false

MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Used only with: docker compose --profile tools up -d
PHPMYADMIN_PORT=8081
